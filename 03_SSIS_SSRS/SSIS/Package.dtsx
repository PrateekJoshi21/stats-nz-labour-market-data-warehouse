                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    CAST('MEI' AS VARCHAR(50)) AS DatasetCode,
    CAST(Series_reference AS NVARCHAR(255)) AS Series_reference,
    Period, 
    TRY_CAST(NULLIF(TRIM(Data_value), '') AS FLOAT) AS DataValue_Clean, 
    CAST(STATUS AS NVARCHAR(50)) AS STATUS, 
    CAST(UNITS AS NVARCHAR(50)) AS UNITS, 
    CAST(Subject AS NVARCHAR(255)) AS Subject, 
    CAST([Group] AS NVARCHAR(255)) AS [Group],
    CASE 
        WHEN Period LIKE '[0-9][0-9][0-9][0-9].[0-9][0-9]' 
        THEN CAST(REPLACE(Period, '.', '') + '01' AS INT) 
        ELSE 19000101 
    END AS DateKey_Clean
FROM stg._employment_indicators_raw

UNION ALL

SELECT 
    CAST('HLFS' AS VARCHAR(50)), CAST(Series_reference AS NVARCHAR(255)), Period, 
    TRY_CAST(NULLIF(TRIM(Data_value), '') AS FLOAT), CAST(STATUS AS NVARCHAR(50)), 
    CAST(UNITS AS NVARCHAR(50)), CAST(Subject AS NVARCHAR(255)), CAST([Group] AS NVARCHAR(255)), 
    CASE WHEN Period LIKE '[0-9][0-9][0-9][0-9].[0-9][0-9]' THEN CAST(REPLACE(Period, '.', '') + '01' AS INT) ELSE 19000101 END 
FROM stg._hlfs_raw

UNION ALL

SELECT 
    CAST('LCI' AS VARCHAR(50)), CAST(Series_reference AS NVARCHAR(255)), Period, 
    TRY_CAST(NULLIF(TRIM(Data_value), '') AS FLOAT), CAST(STATUS AS NVARCHAR(50)), 
    CAST(UNITS AS NVARCHAR(50)), CAST(Subject AS NVARCHAR(255)), CAST([Group] AS NVARCHAR(255)), 
    CASE WHEN Period LIKE '[0-9][0-9][0-9][0-9].[0-9][0-9]' THEN CAST(REPLACE(Period, '.', '') + '01' AS INT) ELSE 19000101 END 
FROM stg._lci_raw

UNION ALL

SELECT 
    CAST('LMS' AS VARCHAR(50)), CAST(Series_reference AS NVARCHAR(255)), Period, 
    TRY_CAST(NULLIF(TRIM(Data_value), '') AS FLOAT), CAST(STATUS AS NVARCHAR(50)), 
    CAST(UNITS AS NVARCHAR(50)), CAST(Subject AS NVARCHAR(255)), CAST([Group] AS NVARCHAR(255)), 
    CASE WHEN Period LIKE '[0-9][0-9][0-9][0-9].[0-9][0-9]' THEN CAST(REPLACE(Period, '.', '') + '01' AS INT) ELSE 19000101 END 
FROM stg._lms_raw

UNION ALL

SELECT 
