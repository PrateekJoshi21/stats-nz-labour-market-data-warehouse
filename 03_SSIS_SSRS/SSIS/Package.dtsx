                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    'HLFS' AS DatasetCode,
    'Household Labour Force Survey' AS DatasetName
FROM stg._hlfs_raw

UNION

SELECT DISTINCT 
    'QES' AS DatasetCode,
    'Quarterly Employment Survey' AS DatasetName
FROM stg._qes_raw

UNION

SELECT DISTINCT 
    'LCI' AS DatasetCode,
    'Labour Cost Index' AS DatasetName
FROM stg._lci_raw

UNION

SELECT DISTINCT 
    'MEI' AS DatasetCode,
    'Monthly Employment Indicators' AS DatasetName
FROM stg._employment_indicators_raw

UNION

SELECT DISTINCT 
    'LMS' AS DatasetCode,
    'Labour Market Statistics' AS DatasetName
FROM stg._lms_raw;</property>
