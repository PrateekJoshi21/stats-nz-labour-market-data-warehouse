                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._employment_indicators_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; ''

UNION

SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._lci_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; ''

UNION

SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._lms_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; ''

UNION

SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._qes_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; ''

UNION

SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._hlfs_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; ''

UNION

SELECT DISTINCT
    CAST(LEFT(ISNULL(Subject, 'N/A'), 255) AS VARCHAR(255)) AS Subject,
    CAST(LEFT(ISNULL([Group], 'N/A'), 255) AS VARCHAR(255)) AS [Group]
FROM stg._household_labour_force_survey_population_raw
WHERE [Group] IS NOT NULL AND [Group] &lt;&gt; '';</property>
