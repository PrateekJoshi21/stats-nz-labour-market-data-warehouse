  <DataSources>
    <DataSource Name="DS_StatsNZ_DW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PRATEEK\IC;Initial Catalog=StatsNZ_LabourMarket_SSIS_DW;TrustServerCertificate=True</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c972b1f3-4a82-4430-bf21-25bc2a5afa43</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DS_StatsNZ_DW</DataSourceName>
        <CommandText>SELECT 
    d.DatasetCode,
    d.DatasetName,
    dt.Year,
    dt.QuarterName,
    g.[Group],
    f.DataValue
FROM dbo.FactLabourMarket f
INNER JOIN dbo.DimDataset d ON f.DatasetKey = d.DatasetKey
INNER JOIN dbo.DimDate dt ON f.DateKey = dt.DateKey
INNER JOIN dbo.DimGroup g ON f.GroupKey = g.GroupKey;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DatasetCode">
          <DataField>DatasetCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DatasetName">
          <DataField>DatasetName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QuarterName">
          <DataField>QuarterName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Group">
          <DataField>Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DataValue">
          <DataField>DataValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
